# 复制为 .env 后编辑。下列变量均用于 docker-compose.yml。

# 生产会话签名密钥（必填）。请生成随机强口令，例如：
#   openssl rand -base64 48
# 该值用于签名会话 cookie，一旦更换即全部用户下线。
NUXT_SESSION_PASSWORD=

# 应用对外映射端口（默认 3000）。
APP_PORT=3000

# MariaDB 容器首次初始化的 root 密码与默认库名。
# 仅在数据卷为空（首次创建）时生效；已有数据卷时修改不会改变密码。
MARIADB_ROOT_PASSWORD=mirai_db_root
MARIADB_DATABASE=mirai